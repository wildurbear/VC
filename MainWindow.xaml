<Window x:Class="VideoCropper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Cropper" Height="760" Width="1100"
        MinHeight="600" MinWidth="900"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="#FF2B2B2B" UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFEDEDED"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,12,2"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFB8D0FF"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <!-- Corner resize handle -->
        <Style x:Key="CornerThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="#FF4FA3FF" Stroke="White" StrokeThickness="1.5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- file row -->
            <RowDefinition Height="*"/>     <!-- preview + controls -->
            <RowDefinition Height="Auto"/>  <!-- output + run -->
            <RowDefinition Height="Auto"/>  <!-- progress/status -->
        </Grid.RowDefinitions>

        <!-- ===== File row ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenButton" Grid.Column="0" Content="Open Video…" Click="OpenButton_Click"/>
            <TextBlock x:Name="InputPathText" Grid.Column="1" Margin="8,0,0,0"
                       Text="No video loaded — click “Open Video…” or drag a file here."
                       TextTrimming="CharacterEllipsis" Foreground="#FFB0B0B0"/>
        </Grid>

        <!-- ===== Main split: preview | controls ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Preview / crop area -->
            <Border Grid.Column="0" Background="#FF1E1E1E" BorderBrush="#FF555555" BorderThickness="1"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- The canvas is sized to the displayed frame; crop overlay lives on it -->
                    <Grid Grid.Row="0">
                        <Canvas x:Name="CropCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="Transparent" ClipToBounds="True">
                            <Image x:Name="PreviewImage" Canvas.Left="0" Canvas.Top="0"/>

                            <Rectangle x:Name="CropRect" Stroke="#FF4FA3FF" StrokeThickness="2"
                                       Fill="#224FA3FF" Visibility="Collapsed"/>

                            <Thumb x:Name="MoveThumb" Cursor="SizeAll" Opacity="0" Visibility="Collapsed"
                                   DragDelta="MoveThumb_DragDelta"/>
                            <Thumb x:Name="TLThumb" Style="{StaticResource CornerThumb}" Cursor="SizeNWSE"
                                   Visibility="Collapsed" DragDelta="TLThumb_DragDelta"/>
                            <Thumb x:Name="TRThumb" Style="{StaticResource CornerThumb}" Cursor="SizeNESW"
                                   Visibility="Collapsed" DragDelta="TRThumb_DragDelta"/>
                            <Thumb x:Name="BLThumb" Style="{StaticResource CornerThumb}" Cursor="SizeNESW"
                                   Visibility="Collapsed" DragDelta="BLThumb_DragDelta"/>
                            <Thumb x:Name="BRThumb" Style="{StaticResource CornerThumb}" Cursor="SizeNWSE"
                                   Visibility="Collapsed" DragDelta="BRThumb_DragDelta"/>
                        </Canvas>

                        <TextBlock x:Name="PreviewHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#FF888888" FontSize="14"
                                   Text="Video frame preview appears here."/>
                    </Grid>

                    <!-- Scrub slider to re-grab the preview frame -->
                    <Grid Grid.Row="1" Margin="8,6,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Frame:" Margin="0,0,8,0"/>
                        <Slider x:Name="ScrubSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                                IsEnabled="False" Thumb.DragCompleted="ScrubSlider_DragCompleted"/>
                        <TextBlock x:Name="ScrubTimeText" Grid.Column="2" Text="00:00.0" Margin="8,0,0,0"
                                   Width="60" TextAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Controls panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Crop readout -->
                    <GroupBox Header="Crop (source pixels)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:"/>
                            <TextBlock x:Name="CropSizeText" Grid.Row="0" Grid.Column="1" Margin="8,2"
                                       Text="—"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset:"/>
                            <TextBlock x:Name="CropOffsetText" Grid.Row="1" Grid.Column="1" Margin="8,2"
                                       Text="—"/>
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="Reset"
                                    VerticalAlignment="Center" Click="ResetCrop_Click"
                                    ToolTip="Reset crop to the full frame"/>
                        </Grid>
                    </GroupBox>

                    <!-- Resize -->
                    <GroupBox Header="Resize output">
                        <StackPanel>
                            <CheckBox x:Name="AspectLockCheck" Content="Lock aspect ratio (no stretch)"
                                      IsChecked="True" Margin="0,0,0,8"
                                      Checked="AspectLock_Changed" Unchecked="AspectLock_Changed"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="W:" Margin="0,0,4,0"/>
                                <TextBox x:Name="ScaleWidthBox" Grid.Column="1"
                                         TextChanged="ScaleWidthBox_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="H:" Margin="10,0,4,0"/>
                                <TextBox x:Name="ScaleHeightBox" Grid.Column="3"
                                         TextChanged="ScaleHeightBox_TextChanged"/>
                            </Grid>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#FF9A9A9A"
                                       Text="Leave both blank to keep the crop size. Dimensions are forced even."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Audio -->
                    <GroupBox Header="Audio">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AudioKeep" Content="Keep" GroupName="Audio" IsChecked="True"
                                             Checked="AudioMode_Changed"/>
                                <RadioButton x:Name="AudioMute" Content="Mute" GroupName="Audio"
                                             Checked="AudioMode_Changed"/>
                                <RadioButton x:Name="AudioVolume" Content="Volume" GroupName="Audio"
                                             Checked="AudioMode_Changed"/>
                            </StackPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="2" Value="1"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" IsEnabled="False"
                                        ValueChanged="VolumeSlider_ValueChanged"/>
                                <TextBlock x:Name="VolumeText" Grid.Column="1" Text="100%" Width="48"
                                           TextAlignment="Right" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Output format -->
                    <GroupBox Header="Output format">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FormatMp4" Content="mp4 (H.264)" GroupName="Format"
                                             IsChecked="True" Checked="Format_Changed"/>
                                <RadioButton x:Name="FormatWebm" Content="webm (VP9)" GroupName="Format"
                                             Checked="Format_Changed"/>
                            </StackPanel>
                            <CheckBox x:Name="NvencCheck" Content="Use GPU (NVENC) — mp4 only"
                                      IsChecked="True" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- FFmpeg location -->
                    <GroupBox Header="FFmpeg location">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FfmpegDirBox" Grid.Column="0" IsReadOnly="True"/>
                                <Button x:Name="FfmpegBrowseButton" Grid.Column="1" Content="Browse…"
                                        Margin="6,0,0,0" Click="FfmpegBrowse_Click"/>
                            </Grid>
                            <TextBlock x:Name="FfmpegStatusText" Margin="0,6,0,0" TextWrapping="Wrap"
                                       FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Output + run ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output:" Margin="0,0,8,0"/>
            <TextBox x:Name="OutputPathBox" Grid.Column="1"/>
            <Button Grid.Column="2" Content="Browse…" Margin="6,0,6,0" Click="OutputBrowse_Click"/>
            <Button x:Name="CopyCmdButton" Grid.Column="3" Content="Copy FFmpeg cmd"
                    Click="CopyCmd_Click" ToolTip="Copy the exact FFmpeg command to the clipboard"/>
            <Button x:Name="RunButton" Grid.Column="4" Content="Run" FontWeight="Bold"
                    Padding="20,5" Background="#FF2E7D32" Foreground="White" Click="Run_Click"/>
            <Button x:Name="CancelButton" Grid.Column="5" Content="Cancel" Visibility="Collapsed"
                    Padding="14,5" Background="#FF9A2E2E" Foreground="White" Click="Cancel_Click"/>
        </Grid>

        <!-- ===== Progress / status ===== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="EncodeProgress" Grid.Column="0" Height="22" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0,0,0" Text="Ready"
                       MinWidth="120"/>
        </Grid>
    </Grid>
</Window>
