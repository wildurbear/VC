<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VideoCropper</AssemblyName>
    <RootNamespace>VideoCropper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Product>Video Cropper</Product>
    <Description>Crop, resize, and re-encode video by driving a local FFmpeg install.</Description>
  </PropertyGroup>

</Project>
